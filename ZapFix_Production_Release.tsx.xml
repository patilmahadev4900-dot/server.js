/* ═══════════════════════════════════════════════════════════════════════════
 *  END OF PART 4 — Production hooks + Root begin in Part 5
 * ═══════════════════════════════════════════════════════════════════════════ */
/* ═══════════════════════════════════════════════════════════════════════════
 * 19.  SECURE VAULT  —  tokens in Keychain / Keystore
 *      Every credential (access token, refresh token) lives in the platform
 *      secure enclave. Never in AsyncStorage, never in plain files.
 * ═══════════════════════════════════════════════════════════════════════════ */

const SecureVault = {
  async set(key: string, value: string) {
    if (!Keychain) return;
    try {
      await Keychain.setGenericPassword(key, value, {
        service: `zapfix.${key}`,
        accessible: Keychain.ACCESSIBLE?.WHEN_UNLOCKED_THIS_DEVICE_ONLY,
      });
    } catch {}
  },
  async get(key: string): Promise<string | null> {
    if (!Keychain) return null;
    try {
      const r = await Keychain.getGenericPassword({ service: `zapfix.${key}` });
      return r && r.password ? r.password : null;
    } catch { return null; }
  },
  async del(key: string) {
    if (!Keychain) return;
    try { await Keychain.resetGenericPassword({ service: `zapfix.${key}` }); } catch {}
  },
};

/* ═══════════════════════════════════════════════════════════════════════════
 * 20.  HTTP CLIENT  —  auto refresh on 401, single retry
 * ═══════════════════════════════════════════════════════════════════════════ */

async function apiFetch(path: string, init: RequestInit = {}, _retried = false): Promise<any> {
  const token = await SecureVault.get('access_token');
  const headers: Record<string, string> = {
    'Content-Type': 'application/json',
    ...((init.headers as Record<string, string>) || {}),
  };
  if (token) headers.Authorization = `Bearer ${token}`;

  const res = await fetch(`${PROD_CONFIG.API_BASE}${path}`, { ...init, headers });

  if (res.status === 401 && !_retried) {
    const refreshed = await refreshAccessToken();
    if (refreshed) return apiFetch(path, init, true);
  }

  const text = await res.text();
  const body = text ? safeJson(text) : null;
  if (!res.ok) {
    const err: any = new Error(body?.error || `HTTP ${res.status}`);
    err.status = res.status;
    err.body = body;
    throw err;
  }
  return body;
}

function safeJson(s: string) { try { return JSON.parse(s); } catch { return null; } }

async function refreshAccessToken(): Promise<boolean> {
  const refresh = await SecureVault.get('refresh_token');
  if (!refresh) return false;
  try {
    const res = await fetch(`${PROD_CONFIG.API_BASE}/auth/refresh`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ refreshToken: refresh }),
    });
    if (!res.ok) return false;
    const data = await res.json();
    await SecureVault.set('access_token', data.accessToken);
    await SecureVault.set('refresh_token', data.refreshToken);
    return true;
  } catch { return false; }
}

/* ═══════════════════════════════════════════════════════════════════════════
 * 21.  GOOGLE OAUTH
 * ═══════════════════════════════════════════════════════════════════════════ */

async function signInWithGoogle(): Promise<{ id: string; email: string; name: string } | null> {
  if (!GoogleSignin) {
    Alert.alert('Google Sign-In unavailable', 'Native module not linked. Rebuild the app.');
    return null;
  }
  try {
    GoogleSignin.configure({
      webClientId: PROD_CONFIG.GOOGLE_WEB_CLIENT_ID,
      iosClientId: Platform.OS === 'ios' ? PROD_CONFIG.GOOGLE_IOS_CLIENT_ID : undefined,
      offlineAccess: false,
      scopes: ['profile', 'email'],
    });
    await GoogleSignin.hasPlayServices();
    const user: any = await GoogleSignin.signIn();
    const idToken = user.idToken || user.data?.idToken;
    if (!idToken) throw new Error('missing_id_token');

    const session = await apiFetch('/auth/google', {
      method: 'POST',
      body: JSON.stringify({ idToken }),
    });
    await SecureVault.set('access_token', session.accessToken);
    await SecureVault.set('refresh_token', session.refreshToken);
    return session.user;
  } catch (err: any) {
    Alert.alert('Sign-in failed', err?.message ?? 'Unknown error');
    return null;
  }
}

async function signOut() {
  try { await apiFetch('/auth/logout', { method: 'POST', body: JSON.stringify({}) }); } catch {}
  await SecureVault.del('access_token');
  await SecureVault.del('refresh_token');
  try { await GoogleSignin?.signOut(); } catch {}
}

/* ═══════════════════════════════════════════════════════════════════════════
 * 22.  HAVERSINE + LOCAL FILE HASH  —  pure utilities used by hooks
 * ═══════════════════════════════════════════════════════════════════════════ */

function haversineMeters(a: { lat: number; lng: number }, b: { lat: number; lng: number }) {
  const R = 6371000;
  const toRad = (x: number) => (x * Math.PI) / 180;
  const dLat = toRad(b.lat - a.lat);
  const dLng = toRad(b.lng - a.lng);
  const s = Math.sin(dLat / 2) ** 2 +
            Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(s));
}

async function hashFileLocal(uri: string): Promise<string> {
  try {
    const res = await fetch(uri);
    const buf = await res.arrayBuffer();
    const bytes = new Uint8Array(buf);
    let s = '';
    for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);
    return sha256(s);
  } catch {
    return sha256(`${uri}-${Date.now()}`);
  }
}

/* ═══════════════════════════════════════════════════════════════════════════
 * 23.  PRODUCTION HOOKS
 * ═══════════════════════════════════════════════════════════════════════════ */

interface LiveFrame { seq: number; lat: number; lng: number; heading: number; ts: number }

/**
 * Connects to the Socket.io telemetry namespace, validates every frame's
 * monotonic sequence, and surfaces the latest verified coordinate.
 * The server has already HMAC-checked the frame — the client just guards
 * against replays.
 */
function useProductionTelemetry(jobId: string | null) {
  const [frame, setFrame] = useState<LiveFrame | null>(null);
  const [connected, setConnected] = useState(false);
  const sockRef = useRef<any>(null);
  const lastSeqRef = useRef<number>(-1);

  useEffect(() => {
    if (!jobId || !IOClient) return;
    let cancelled = false;
    lastSeqRef.current = -1;

    (async () => {
      const token = await SecureVault.get('access_token');
      if (!token || cancelled) return;

      const sock = IOClient(`${PROD_CONFIG.WSS_TELEMETRY}/telemetry`, {
        transports: ['websocket'],
        auth: { token, jobId, role: 'homeowner' },
        reconnection: true,
        reconnectionAttempts: Infinity,
        reconnectionDelay: 1000,
        reconnectionDelayMax: 10000,
      });
      sockRef.current = sock;

      sock.on('connect', () => setConnected(true));
      sock.on('disconnect', () => setConnected(false));

      sock.on('frame', (f: LiveFrame) => {
        if (!f || typeof f.seq !== 'number') return;
        if (f.seq <= lastSeqRef.current) return;
        lastSeqRef.current = f.seq;
        setFrame(f);
      });
    })();

    return () => {
      cancelled = true;
      try { sockRef.current?.disconnect(); } catch {}
      sockRef.current = null;
    };
  }, [jobId]);

  return { frame, connected };
}

/**
 * Native 10-second inspection recorder wrapping react-native-vision-camera.
 * Returns undefined when the native module isn't linked so the CameraScreen
 * gracefully falls back to the demo's simulation.
 */
function useInspectionRecorder(): RecorderShape | undefined {
  const [recording, setRecording] = useState(false);
  const [secondsLeft, setSecondsLeft] = useState(10);
  const [result, setResult] = useState<{ path: string; hash: string } | null>(null);
  const [permission, setPermission] = useState<'unknown' | 'granted' | 'denied'>('unknown');
  const cameraRef = useRef<any>(null);
  const timerRef = useRef<any>(null);

  const device = VisionHooks.useCameraDevice ? VisionHooks.useCameraDevice('back') : null;
  const format = VisionHooks.useCameraFormat && device
    ? VisionHooks.useCameraFormat(device, [
        { videoResolution: { width: 1920, height: 1080 } },
        { fps: 30 },
      ])
    : null;

  const camPerm = VisionHooks.useCameraPermission ? VisionHooks.useCameraPermission() : null;
  const micPerm = VisionHooks.useMicrophonePermission ? VisionHooks.useMicrophonePermission() : null;

  useEffect(() => {
    (async () => {
      if (!camPerm) { setPermission('denied'); return; }
      if (!camPerm.hasPermission) {
        const r = await camPerm.requestPermission();
        if (!r) { setPermission('denied'); return; }
      }
      if (micPerm && !micPerm.hasPermission) {
        const r = await micPerm.requestPermission();
        if (!r) { setPermission('denied'); return; }
      }
      setPermission('granted');
    })();
  }, [camPerm?.hasPermission, micPerm?.hasPermission]);

  const start = useCallback(async () => {
    if (!cameraRef.current || recording) return;
    setResult(null);
    setSecondsLeft(10);
    setRecording(true);

    try {
      await cameraRef.current.startRecording({
        flash: 'off',
        onRecordingFinished: async (v: { path: string }) => {
          const hash = await hashFileLocal(v.path);
          setResult({ path: v.path, hash });
          setRecording(false);
          if (timerRef.current) { clearInterval(timerRef.current); timerRef.current = null; }
          Vibration.vibrate(120);
        },
        onRecordingError: (e: any) => {
          setRecording(false);
          if (timerRef.current) { clearInterval(timerRef.current); timerRef.current = null; }
          Alert.alert('Recording failed', e?.message ?? 'Unknown error');
        },
      });

      timerRef.current = setInterval(() => {
        setSecondsLeft(s => {
          if (s <= 1) {
            try { cameraRef.current?.stopRecording(); } catch {}
            if (timerRef.current) { clearInterval(timerRef.current); timerRef.current = null; }
            return 0;
          }
          return s - 1;
        });
      }, 1000);
    } catch (err: any) {
      setRecording(false);
      Alert.alert('Camera error', err?.message ?? 'Unable to start recording.');
    }
  }, [recording]);

  useEffect(() => () => { if (timerRef.current) clearInterval(timerRef.current); }, []);

  if (!VisionHooks || !VisionHooks.Camera) return undefined;

  return { cameraRef, device, format, recording, secondsLeft, result, permission, start };
}

/**
 * Masked WebRTC call. Fetches short-lived TURN credentials from the backend,
 * opens a peer connection over the /signaling Socket.io namespace, and never
 * reveals either party's PSTN number.
 */
function useMaskedCall(jobId: string | null) {
  const [state, setState] = useState<'idle' | 'connecting' | 'ringing' | 'connected' | 'ended' | 'error'>('idle');
  const pcRef = useRef<any>(null);
  const localStreamRef = useRef<any>(null);
  const sigRef = useRef<any>(null);
  const [remoteStream, setRemoteStream] = useState<any>(null);

  const end = useCallback(() => {
    try { localStreamRef.current?.getTracks?.().forEach((t: any) => t.stop()); } catch {}
    try { pcRef.current?.close?.(); } catch {}
    try { sigRef.current?.disconnect?.(); } catch {}
    pcRef.current = null;
    localStreamRef.current = null;
    sigRef.current = null;
    setRemoteStream(null);
    setState('ended');
  }, []);

  const start = useCallback(async () => {
    if (!jobId || !RTCPeerConnection || !mediaDevices || !IOClient) {
      setState('error');
      Alert.alert('Call unavailable', 'WebRTC native module not linked.');
      return;
    }
    setState('connecting');

    try {
      const token = await SecureVault.get('access_token');
      if (!token) throw new Error('missing_token');

      const turn = await apiFetch(`/turn?jobId=${encodeURIComponent(jobId)}`);

      const sig = IOClient(`${PROD_CONFIG.API_BASE.replace('/v1', '')}/signaling`, {
        transports: ['websocket'],
        auth: { token, jobId, role: 'homeowner' },
      });
      sigRef.current = sig;

      const local = await mediaDevices.getUserMedia({ audio: true, video: false });
      localStreamRef.current = local;

      const pc = new RTCPeerConnection({ iceServers: turn.iceServers });
      pcRef.current = pc;
      local.getTracks().forEach((tr: any) => pc.addTrack(tr, local));

      pc.ontrack = (e: any) => {
        if (e.streams && e.streams[0]) {
          setRemoteStream(e.streams[0]);
          setState('connected');
        }
      };
      pc.onicecandidate = (e: any) => { if (e.candidate) sig.emit('ice', e.candidate); };
      pc.onconnectionstatechange = () => {
        const cs = pc.connectionState;
        if (cs === 'connected') setState('connected');
        if (cs === 'failed' || cs === 'disconnected') end();
      };

      sig.on('offer', async (offer: any) => {
        await pc.setRemoteDescription(new RTCSessionDescription(offer));
        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        sig.emit('answer', answer);
      });
      sig.on('ice', async (c: any) => {
        try { await pc.addIceCandidate(new RTCIceCandidate(c)); } catch {}
      });
      sig.on('connect', () => setState('ringing'));
      sig.emit('dial', { jobId });
    } catch (err: any) {
      setState('error');
      Alert.alert('Call failed', err?.message ?? 'Unknown error');
    }
  }, [jobId, end]);

  useEffect(() => () => end(), [end]);

  return { state, start, end, remoteStream };
}

/**
 * Payments: create hold, confirm arrival capture, settle final balance.
 * Stripe path uses confirmPayment with the server-issued clientSecret.
 * Razorpay path opens the native checkout with the server-issued order_id.
 */
function useZapFixPayments() {
  const stripe = useStripe();

  const placeHold = useCallback(async (params: {
    trade: string; address: string; propertyLat: number; propertyLng: number;
    mediaHash: string; holdProvider: 'stripe' | 'razorpay';
  }) => {
    const job = await apiFetch('/jobs', {
      method: 'POST',
      body: JSON.stringify(params),
    });

    if (params.holdProvider === 'stripe') {
      if (!stripe) throw new Error('stripe_not_ready');
      const { error } = await stripe.confirmPayment(job.clientSecret, {
        paymentMethodType: 'Card',
      });
      if (error) throw new Error(error.message);
    } else {
      if (!RazorpayCheckout) throw new Error('razorpay_not_linked');
      const options = {
        description: `ZapFix diagnostic hold — Job ${job.jobId}`,
        currency: 'INR',
        key: PROD_CONFIG.RAZORPAY_KEY_ID,
        amount: String(PROD_CONFIG.HOLD_AMOUNT_PAISE),
        order_id: job.holdRef,
        name: 'ZapFix',
        prefill: {},
        theme: { color: '#4DA3FF' },
      };
      const result = await RazorpayCheckout.open(options);
      await SecureVault.set(`rzp.${job.jobId}`, result.razorpay_payment_id);
    }

    return job as { jobId: string; holdState: 'locked'; holdProvider: string; expiresAt: string };
  }, [stripe]);

  const confirmArrival = useCallback(async (jobId: string) => {
    const rzpId = await SecureVault.get(`rzp.${jobId}`);
    return apiFetch(`/jobs/${jobId}/arrive`, {
      method: 'POST',
      body: JSON.stringify(rzpId ? { razorpayPaymentId: rzpId } : {}),
    });
  }, []);

  const settleFinal = useCallback(async (jobId: string, laborHours: number, partsCents: number) => {
    const bill = await apiFetch(`/jobs/${jobId}/bill`, {
      method: 'POST',
      body: JSON.stringify({ laborHours, partsCents }),
    });
    return bill as { bill: any; invoiceAnchor: string };
  }, []);

  const fetchInvoiceUrl = useCallback((jobId: string) => {
    return `${PROD_CONFIG.API_BASE}/jobs/${jobId}/invoice.pdf`;
  }, []);

  return { placeHold, confirmArrival, settleFinal, fetchInvoiceUrl };
}

/**
 * Safety Desk: proxies to /v1/safety/:jobId/message.
 * The Gemini key never touches the device — the backend handles arbitration
 * and returns a structured response including any auto-generated ticket.
 */
function useSafetyDesk(jobId: string | null) {
  const send = useCallback(async (text: string) => {
    if (!jobId) return null;
    try {
      const res = await apiFetch(`/safety/${jobId}/message`, {
        method: 'POST',
        body: JSON.stringify({ text }),
      });
      return res;
    } catch (err: any) {
      return {
        message: `Safety Desk temporarily unavailable (${err?.message ?? 'network'}). If you are in danger, call 911/112 immediately.`,
        category: null,
        freeze_escrow: false,
        emergency_shutoff: null,
        severity: 'low',
        ticket: null,
      };
    }
  }, [jobId]);
  return { send };
}

/**
 * Watches verified frames and calls /jobs/:id/arrive the moment the tech
 * crosses the 25 m geofence. Server re-verifies against the same frame.
 */
function useGeofenceArrival(params: {
  jobId: string | null;
  propertyLat: number;
  propertyLng: number;
  frame: LiveFrame | null;
  enabled: boolean;
  onArrived: (payload: any) => void;
  confirmArrival: (jobId: string) => Promise<any>;
}) {
  const { jobId, propertyLat, propertyLng, frame, enabled, onArrived, confirmArrival } = params;
  const firedRef = useRef(false);

  useEffect(() => {
    if (!enabled || !jobId || !frame || firedRef.current) return;
    const d = haversineMeters(
      { lat: propertyLat, lng: propertyLng },
      { lat: frame.lat, lng: frame.lng },
    );
    if (d <= PROD_CONFIG.GEOFENCE_METERS) {
      firedRef.current = true;
      (async () => {
        try {
          const res = await confirmArrival(jobId);
          Vibration.vibrate([0, 80, 60, 80]);
          onArrived(res);
        } catch (err) {
          firedRef.current = false;
          console.warn('[geofence] arrival failed', err);
        }
      })();
    }
  }, [frame, jobId, propertyLat, propertyLng, enabled, onArrived, confirmArrival]);
}

/**
 * Maps the live HMAC-verified lat/lng onto the demo's ROUTE polyline so
 * MapScreen can render the beacon at the correct position without any code
 * changes to the shared screen.
 */
function useRouteProgress(frame: LiveFrame | null, propertyLat: number, propertyLng: number) {
  return useMemo(() => {
    if (!frame) return { progress: 0, etaMinutes: 8, distanceMi: 2.1 };
    const d = haversineMeters({ lat: frame.lat, lng: frame.lng }, { lat: propertyLat, lng: propertyLng });
    const totalM = 3379.6; // 2.1 mi in meters — matches the demo's origin distance
    const p = Math.max(0, Math.min(1, 1 - d / totalM));
    const eta = Math.max(0, Math.round((1 - p) * 8));
    const mi = (1 - p) * 2.1;
    return { progress: p, etaMinutes: eta, distanceMi: mi };
  }, [frame, propertyLat, propertyLng]);
}

/* ═══════════════════════════════════════════════════════════════════════════
 *  END OF PART 5 — ProductionRoot + StripeProvider + native config in Part 6
 * ═══════════════════════════════════════════════════════════════════════════ */
/* ═══════════════════════════════════════════════════════════════════════════
 * 24.  PRODUCTION ROOT
 *      Wires every screen from Parts 2-4 to the real SDK hooks from Part 5.
 *      State machine mirrors the demo — hold lifecycle, receipt approvals,
 *      screen transitions, theme toggle — but every effectful boundary now
 *      hits the real backend.
 * ═══════════════════════════════════════════════════════════════════════════ */

const PROPERTY = { lat: 39.1911, lng: -106.8175 }; // 442 Summit Ridge Way

interface ProductionState {
  screen: ScreenName;
  activeTrade: Trade | null;
  holdState: HoldState;
  mediaHash: string | null;
  payRail: string;
  bill: JobBill;
  receipts: MaterialReceipt[];
  warrantyStart: number | null;
  activePropertyId: string;
}

const ProductionRootInner: React.FC = () => {
  const [themeName, setThemeName] = useState<ThemeName>('obsidian');
  const t = THEMES[themeName];
  const toggle = useCallback(() => setThemeName(n => n === 'glacial' ? 'obsidian' : 'glacial'), []);

  const [state, setState] = useState<ProductionState>({
    screen: 'splash',
    activeTrade: null,
    holdState: 'none',
    mediaHash: null,
    payRail: 'stripe',
    bill: DEFAULT_BILL,
    receipts: [
      { id: 'r1', store: 'Home Depot · Aspen #4471', part: 'Brass 3/4" shutoff valve assembly', cost: 28.40, approved: null },
      { id: 'r2', store: 'Ferguson · Glenwood Springs', part: 'OEM water heater dielectric union kit', cost: 19.80, approved: null },
    ],
    warrantyStart: null,
    activePropertyId: 'p1',
  });

  const [jobId, setJobId] = useState<string | null>(null);
  const [user, setUser] = useState<{ id: string; email: string; name: string } | null>(null);
  const [bootstrapped, setBootstrapped] = useState(false);
  const [chatOpen, setChatOpen] = useState(false);
  const [authing, setAuthing] = useState(false);
  const [authorizing, setAuthorizing] = useState(false);

  const [properties] = useState([
    { id: 'p1', label: 'Primary Residence', address: '442 Summit Ridge Way, Aspen, CO', gate: '#4401', notes: 'Dog in backyard' },
    { id: 'p2', label: 'Mountain Cabin',    address: '88 Elk Meadow Trail, Snowmass, CO', gate: 'Lockbox 7782', notes: 'Well water only' },
    { id: 'p3', label: 'Rental Property',   address: '1220 Basalt Ave Unit B, Basalt, CO', gate: '#0910', notes: 'Tenant: J. Ortega' },
  ]);
  const [sosContacts] = useState([
    '+1 (970) 555-0142 · Avery Chen',
    '+1 (970) 555-8810 · Dr. R. Patel (neighbor)',
  ]);

  /* ─── Live hooks ────────────────────────────────────────────────────────── */
  const telemetry = useProductionTelemetry(jobId);
  const recorder = useInspectionRecorder();
  const call = useMaskedCall(jobId);
  const payments = useZapFixPayments();
  const safety = useSafetyDesk(jobId);
  const routeProgress = useRouteProgress(telemetry.frame, PROPERTY.lat, PROPERTY.lng);

  const handleArrived = useCallback((payload: any) => {
    setState(s => ({ ...s, holdState: 'captured', screen: 'arrival' }));
    Alert.alert(
      'Arrival Confirmed',
      `Tech on-site (${payload?.distance_m ?? '—'} m). $69 hold captured.`,
    );
  }, []);

  useGeofenceArrival({
    jobId,
    propertyLat: PROPERTY.lat,
    propertyLng: PROPERTY.lng,
    frame: telemetry.frame,
    enabled: state.holdState === 'locked' && state.screen === 'map',
    onArrived: handleArrived,
    confirmArrival: payments.confirmArrival,
  });

  /* ─── Bootstrap: restore session on cold start ─────────────────────────── */
  useEffect(() => {
    (async () => {
      try {
        await initStripe({
          publishableKey: PROD_CONFIG.STRIPE_PUBLISHABLE,
          merchantIdentifier: 'merchant.app.zapfix',
          urlScheme: 'zapfix',
        });
      } catch {
        /* Stripe optional at boot — will error loudly if used without config */
      }

      const token = await SecureVault.get('access_token');
      if (token) {
        try {
          const me = await apiFetch('/me');
          setUser(me.user);
        } catch {
          await SecureVault.del('access_token');
        }
      }
      setBootstrapped(true);
    })();
  }, []);

  /* ─── Auto-resolve splash after 2 s ────────────────────────────────────── */
  useEffect(() => {
    if (!bootstrapped) return;
    const timer = setTimeout(() => {
      setState(s => s.screen === 'splash' ? { ...s, screen: 'home' } : s);
    }, 2000);
    return () => clearTimeout(timer);
  }, [bootstrapped]);

  /* ─── App state listener: reconnect sockets when foregrounded ──────────── */
  useEffect(() => {
    const sub = AppState.addEventListener('change', (next) => {
      if (next === 'active' && jobId) {
        /* socket.io-client handles its own reconnection backoff */
      }
    });
    return () => sub.remove();
  }, [jobId]);

  /* ─── Actions ──────────────────────────────────────────────────────────── */

  const handleSignIn = useCallback(async () => {
    setAuthing(true);
    const u = await signInWithGoogle();
    setAuthing(false);
    if (u) setUser(u);
  }, []);

  const handleSignOut = useCallback(async () => {
    await signOut();
    setUser(null);
    setJobId(null);
    setState(s => ({
      ...s,
      screen: 'home',
      holdState: 'none',
      activeTrade: null,
      mediaHash: null,
    }));
  }, []);

  const handleDispatch = useCallback((trade: Trade) => {
    setState(s => ({ ...s, activeTrade: trade, screen: 'dispatch' }));
  }, []);

  const handleAuthorize = useCallback(async () => {
    if (!state.activeTrade || !state.mediaHash) return;
    setAuthorizing(true);
    try {
      const job = await payments.placeHold({
        trade: state.activeTrade,
        address: '442 Summit Ridge Way, Aspen, CO 81611',
        propertyLat: PROPERTY.lat,
        propertyLng: PROPERTY.lng,
        mediaHash: state.mediaHash,
        holdProvider: state.payRail === 'razorpay' ? 'razorpay' : 'stripe',
      });
      setJobId(job.jobId);
      setState(s => ({ ...s, holdState: 'locked', screen: 'map' }));
    } catch (err: any) {
      Alert.alert('Authorization failed', err?.message ?? 'Unknown error');
    } finally {
      setAuthorizing(false);
    }
  }, [state.activeTrade, state.mediaHash, state.payRail, payments]);

  const handleCaptureMedia = useCallback((hash: string) => {
    setState(s => ({ ...s, mediaHash: hash, screen: 'dispatch' }));
  }, []);

  const handleGallery = useCallback(() => {
    const h = sha256(`gallery-${Date.now()}-${Math.random()}`);
    setState(s => ({ ...s, mediaHash: h, screen: 'dispatch' }));
  }, []);

  const handleReceiptDecision = useCallback(async (id: string, approve: boolean) => {
    setState(s => ({
      ...s,
      receipts: s.receipts.map(r => r.id === id ? { ...r, approved: approve } : r),
    }));
    if (jobId) {
      try {
        await apiFetch(`/jobs/${jobId}/receipts/${id}/decide`, {
          method: 'POST',
          body: JSON.stringify({ approved: approve }),
        });
      } catch (err) {
        console.warn('[receipt decide]', err);
      }
    }
  }, [jobId]);

  const handleSettle = useCallback(async () => {
    if (!jobId) return;
    try {
      await payments.settleFinal(
        jobId,
        state.bill.laborHours,
        Math.round(state.bill.parts * 100),
      );
      setState(s => ({ ...s, warrantyStart: Date.now(), screen: 'activity' }));
      Alert.alert('Settled', 'Job closed. 30-day zero-leak warranty started.');
    } catch (err: any) {
      Alert.alert('Settlement failed', err?.message ?? 'Unknown error');
    }
  }, [jobId, state.bill, payments]);

  const handleRedeem = useCallback(() => {
    setState(s => ({ ...s, warrantyStart: Date.now() }));
    Alert.alert('Re-dispatch Booked', 'Free 30-day warranty re-dispatch scheduled on-platform.');
  }, []);

  const handleDownloadPdf = useCallback(() => {
    if (!jobId) {
      Alert.alert('No job', 'Dispatch first to generate an invoice.');
      return;
    }
    const url = payments.fetchInvoiceUrl(jobId);
    Alert.alert(
      'Invoice PDF',
      `Insurer-certified invoice available at:

${url}

Share this URL with your claims adjuster. In production, ZapFix issues a time-limited signed URL from the insurer portal.`,
    );
  }, [jobId, payments]);

  /* ─── Theme context ────────────────────────────────────────────────────── */
  const ctxValue = useMemo(() => ({ t, toggle }), [t, toggle]);

  const isFullscreen =
    state.screen === 'camera' || state.screen === 'aiDesk' || state.screen === 'splash';

  const showChrome =
    state.screen !== 'splash' && state.screen !== 'camera' && state.screen !== 'aiDesk';

  /* ─── Render ───────────────────────────────────────────────────────────── */
  return (
    <ThemeContext.Provider value={ctxValue}>
      <StatusBar barStyle={themeName === 'obsidian' ? 'light-content' : 'dark-content'} />
      <View style={{ flex: 1, backgroundColor: t.bg }}>
        {!isFullscreen && <ContourBackground />}
        {showChrome && <MountainRidges bottomOffset={0} />}

        <SafeAreaView style={{ flex: 1 }}>
          {state.screen === 'splash' && (
            <SplashScreen onDone={() => setState(s => ({ ...s, screen: 'home' }))} />
          )}

          {state.screen === 'home' && (
            <HomeScreen
              holdState={state.holdState}
              etaMinutes={routeProgress.etaMinutes}
              onDispatch={handleDispatch}
              onNav={(s) => setState(st => ({ ...st, screen: s }))}
            />
          )}

          {state.screen === 'dispatch' && state.activeTrade && (
            <DispatchScreen
              trade={state.activeTrade}
              onBack={() => setState(s => ({ ...s, screen: 'home' }))}
              mediaHash={state.mediaHash}
              onOpenCamera={() => setState(s => ({ ...s, screen: 'camera' }))}
              payRail={state.payRail}
              setPayRail={(r) => setState(s => ({ ...s, payRail: r }))}
              onAuthorize={handleAuthorize}
              authorizing={authorizing}
            />
          )}

          {state.screen === 'camera' && (
            <CameraScreen
              onCapture={handleCaptureMedia}
              onBack={() => setState(s => ({ ...s, screen: 'dispatch' }))}
              onGallery={handleGallery}
              recorder={recorder}
            />
          )}

          {state.screen === 'map' && (
            <MapScreen
              progress={routeProgress.progress}
              etaMinutes={routeProgress.etaMinutes}
              distanceMi={routeProgress.distanceMi}
              onArrive={() => { /* handled by useGeofenceArrival */ }}
              onCall={async () => {
                try { await call.start(); } catch {}
              }}
              onChat={() => setChatOpen(true)}
            />
          )}

          {state.screen === 'arrival' && (
            <ArrivalScreen
              receipts={state.receipts}
              onDecide={handleReceiptDecision}
              onContinue={() => setState(s => ({ ...s, screen: 'activity' }))}
            />
          )}

          {state.screen === 'activity' && (
            <ActivityScreen
              bill={state.bill}
              warrantyStart={state.warrantyStart}
              mediaHash={state.mediaHash}
              onRedeem={handleRedeem}
              onDownloadPdf={handleDownloadPdf}
            />
          )}

          {state.screen === 'payment' && (
            <PaymentScreen
              bill={state.bill}
              holdState={state.holdState}
              onSettle={handleSettle}
            />
          )}

          {state.screen === 'vault' && (
            <VaultScreen
              theme={t}
              toggle={toggle}
              properties={properties}
              activeId={state.activePropertyId}
              setActive={(id) => setState(s => ({ ...s, activePropertyId: id }))}
              sos={sosContacts}
              user={user}
              onSignOut={user ? handleSignOut : undefined}
            />
          )}

          {state.screen === 'aiDesk' && (
            <AiSafetyDesk
              onClose={() => setState(s => ({ ...s, screen: 'home' }))}
              jobId={jobId}
              sendMessage={jobId ? safety.send : undefined}
            />
          )}

          {showChrome && (
            <TabBar
              screen={state.screen}
              onNav={(s) => setState(st => ({ ...st, screen: s }))}
            />
          )}

          {chatOpen && (
            <Modal visible transparent animationType="slide" onRequestClose={() => setChatOpen(false)}>
              <View style={{ flex: 1, backgroundColor: 'rgba(0,0,0,0.42)', justifyContent: 'flex-end' }}>
                <View style={{ height: '80%', borderTopLeftRadius: 26, borderTopRightRadius: 26, overflow: 'hidden' }}>
                  <ChatDrawer onClose={() => setChatOpen(false)} jobId={jobId} />
                </View>
              </View>
            </Modal>
          )}

          {/* Sign-in banner — visible until authenticated */}
          {!user && bootstrapped && state.screen !== 'splash' && (
            <TouchableOpacity
              onPress={handleSignIn}
              style={{
                position: 'absolute', top: 44, left: 18, right: 18,
                backgroundColor: t.accent, borderRadius: 16, padding: 14,
                alignItems: 'center',
                shadowColor: t.accent, shadowOpacity: 0.6, shadowRadius: 14,
              }}
            >
              {authing
                ? <ActivityIndicator color="#fff" />
                : <Text style={{ color: '#fff', fontWeight: '900', fontSize: 14, letterSpacing: 0.6 }}>
                    Sign in with Google to dispatch
                  </Text>}
            </TouchableOpacity>
          )}

          {/* Telemetry connection badge — subtle, bottom-right */}
          {jobId && state.screen === 'map' && (
            <View style={{
              position: 'absolute', top: 52, right: 18,
              flexDirection: 'row', alignItems: 'center', gap: 6,
              paddingHorizontal: 10, paddingVertical: 5, borderRadius: 999,
              backgroundColor: t.glass, borderWidth: 1, borderColor: t.glassBorder,
            }}>
              <View style={{
                width: 8, height: 8, borderRadius: 4,
                backgroundColor: telemetry.connected ? t.success : t.warn,
              }} />
              <Text style={{ color: t.textDim, fontSize: 10, fontWeight: '900', letterSpacing: 0.6 }}>
                {telemetry.connected ? 'LIVE' : 'RECONNECTING'}
              </Text>
            </View>
          )}
        </SafeAreaView>
      </View>
    </ThemeContext.Provider>
  );
};

/* ═══════════════════════════════════════════════════════════════════════════
 * 25.  STRIPE PROVIDER WRAPPER
 *      The root component wraps the whole app in StripeProvider so any
 *      descendant hook (useStripe) resolves against the live publishable key.
 * ═══════════════════════════════════════════════════════════════════════════ */

const ProductionRoot: React.FC = () => {
  return (
    <StripeProvider
      publishableKey={PROD_CONFIG.STRIPE_PUBLISHABLE}
      merchantIdentifier="merchant.app.zapfix"
      urlScheme="zapfix"
    >
      <ProductionRootInner />
    </StripeProvider>
  );
};

export default ProductionRoot;

