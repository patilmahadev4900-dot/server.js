/* ═══════════════════════════════════════════════════════════════════════════
 * 16.  SCREEN 10 — AI SAFETY DESK
 *      Production override: optional `sendMessage` prop. When provided,
 *      the desk proxies through the backend's Gemini route; when absent,
 *      it falls back to the demo's local keyword classifier.
 * ═══════════════════════════════════════════════════════════════════════════ */

interface ChatMsg {
  id: string;
  role: 'user' | 'ai';
  text: string;
  ticket?: DisputeTicket;
  actions?: string[];
}

const AiSafetyDesk: React.FC<{
  onClose: () => void;
  jobId?: string | null;
  sendMessage?: (text: string) => Promise<{
    message: string;
    category: string | null;
    freeze_escrow: boolean;
    emergency_shutoff: string | null;
    severity: 'low' | 'medium' | 'high' | 'critical';
    ticket: DisputeTicket | null;
  } | null>;
  onLocalTicket?: (category: string, summary: string) => DisputeTicket;
}> = ({ onClose, sendMessage, onLocalTicket }) => {
  const { t } = useTheme();
  const [input, setInput] = useState('');
  const [busy, setBusy] = useState(false);
  const [msgs, setMsgs] = useState<ChatMsg[]>([{
    id: 'init', role: 'ai',
    text: "I'm ZapFix Safety Desk, active 24/7. Tell me what happened — off-platform cash requests, unsafe work, harassment, or an active emergency. I can freeze escrow payouts, generate a dispute ticket, and walk you through utility shutoffs.",
  }]);
  const scroll = useRef<ScrollView>(null);

  const rules: { re: RegExp; cat: string; label: string }[] = [
    { re: /(cash|off.?platform|off platform|venmo|zelle|under the table|बिना बिल|कैश)/i, cat: 'OFF_PLATFORM_SOLICITATION', label: 'Off-platform cash solicitation' },
    { re: /(harass|threat|abusive|unprofessional|गाली|धमकी)/i, cat: 'CONDUCT_VIOLATION', label: 'Harassment / unprofessional conduct' },
    { re: /(collapse|structural|flooding|fire|gas leak|explosion|unsafe|danger|आग|धमाका|रिसाव)/i, cat: 'PHYSICAL_DANGER', label: 'Severe physical danger / structural hazard' },
    { re: /(unlicensed|subcontractor|someone else|different person|अवैध|दूसरा आदमी)/i, cat: 'LICENSE_SUBSTITUTION', label: 'Unlicensed subcontractor substitution' },
  ];

  const handleLocal = (text: string) => {
    const hit = rules.find(r => r.re.test(text));
    if (hit) {
      const ticket = onLocalTicket
        ? onLocalTicket(hit.cat, text)
        : { id: `DISPUTE-${Math.floor(10000 + Math.random() * 89999)}`, category: hit.cat, summary: text, frozen: true, ts: Date.now() };
      setMsgs(m => [...m, {
        id: `a${Date.now()}`, role: 'ai',
        text: `This matches a critical violation category: ${hit.label}.\n\nI have:\n• Generated dispute ticket ${ticket.id}\n• Instantly frozen the technician's escrow payout pending executive human review\n• Escalated to the ZapFix Trust & Safety team\n\nKeep this chat open as your evidence record. If there is an immediate physical danger, use the Emergency 911 button below.`,
        ticket,
        actions: ['Emergency 911', 'Request shutoff guide', 'Escalate to human'],
      }]);
      return;
    }
    if (/shut ?off|water|gas|पानी|गैस/i.test(text)) {
      setMsgs(m => [...m, {
        id: `a${Date.now()}`, role: 'ai',
        text: "Utility shutoff guide:\n\nWATER — Locate the main shutoff (usually near the meter or where the supply enters the home). Turn clockwise until fully closed.\n\nGAS — Find the meter's shutoff valve on the incoming pipe. Using a wrench, turn the valve 90° so it's perpendicular to the pipe. Do NOT force it. Once off, do not turn it back on — call the utility.",
        actions: ['Open utility locator', 'Call plumber now'],
      }]);
      return;
    }
    setMsgs(m => [...m, {
      id: `a${Date.now()}`, role: 'ai',
      text: "Thanks — I've logged that. If this involves off-platform cash, unsafe conditions, harassment, or license substitution, describe it in those words and I'll open a formal dispute ticket and freeze the payout.",
    }]);
  };

  const send = async () => {
    const text = input.trim();
    if (!text || busy) return;
    setInput('');
    setMsgs(m => [...m, { id: `u${Date.now()}`, role: 'user', text }]);

    if (sendMessage) {
      setBusy(true);
      try {
        const res = await sendMessage(text);
        if (res) {
          const actions: string[] = [];
          if (res.emergency_shutoff) actions.push('Shutoff guide');
          if (res.freeze_escrow) actions.push('Escrow frozen');
          if (res.severity === 'critical') actions.push('Emergency 911');
          setMsgs(m => [...m, {
            id: `a${Date.now()}`, role: 'ai',
            text: res.message + (res.emergency_shutoff ? `\n\n${res.emergency_shutoff}` : ''),
            ticket: res.ticket ?? undefined,
            actions: actions.length ? actions : undefined,
          }]);
        } else {
          handleLocal(text);
        }
      } finally {
        setBusy(false);
      }
    } else {
      setTimeout(() => handleLocal(text), 420);
    }
    setTimeout(() => scroll.current?.scrollToEnd({ animated: true }), 100);
  };

  return (
    <KeyboardAvoidingView style={{ flex: 1, backgroundColor: t.bg }} behavior={Platform.OS === 'ios' ? 'padding' : undefined}>
      <StatusBar barStyle={t.name === 'obsidian' ? 'light-content' : 'dark-content'} />
      <SafeAreaView style={{ flex: 1 }}>
        <View style={{ padding: 18, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
          <View style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <View style={{
              width: 44, height: 44, borderRadius: 14,
              backgroundColor: t.accent,
              alignItems: 'center', justifyContent: 'center',
              shadowColor: t.accent, shadowOpacity: 0.6, shadowRadius: 12,
            }}><Text style={{ fontSize: 22 }}>🛡️</Text></View>
            <View>
              <Text style={{ color: t.text, fontWeight: '900', fontSize: 16 }}>Safety Desk</Text>
              <Text style={{ color: t.textDim, fontSize: 11, marginTop: 2 }}>24/7 · Gemini-powered arbitration</Text>
            </View>
          </View>
          <TouchableOpacity onPress={onClose}>
            <View style={{
              width: 40, height: 40, borderRadius: 20,
              backgroundColor: t.glass, borderWidth: 1, borderColor: t.glassBorder,
              alignItems: 'center', justifyContent: 'center',
            }}><Text style={{ color: t.accent, fontWeight: '900', fontSize: 14 }}>✕</Text></View>
          </TouchableOpacity>
        </View>

        <ScrollView ref={scroll} contentContainerStyle={{ paddingHorizontal: 18, paddingBottom: 30 }}>
          {msgs.map(m => (
            <View key={m.id} style={{ marginBottom: 14, alignItems: m.role === 'user' ? 'flex-end' : 'flex-start' }}>
              <Glass style={{
                padding: 14, maxWidth: '88%',
                backgroundColor: m.role === 'user' ? t.accent : t.glass,
                borderColor: m.role === 'user' ? t.accent : t.glassBorder,
              }}>
                <Text style={{ color: m.role === 'user' ? '#fff' : t.text, fontSize: 13.5, lineHeight: 20 }}>{m.text}</Text>
              </Glass>
              {m.ticket ? (
                <Glass style={{ padding: 12, marginTop: 8, maxWidth: '88%', borderColor: t.danger, borderWidth: 1.6 }}>
                  <Text style={{ color: t.danger, fontWeight: '900', fontSize: 11, letterSpacing: 1.4 }}>DISPUTE {m.ticket.id}</Text>
                  <Text style={{ color: t.textDim, fontSize: 11.5, marginTop: 6 }}>Category: {m.ticket.category}</Text>
                  <Text style={{ color: t.success, fontSize: 11.5, marginTop: 4, fontWeight: '900' }}>ESCROW FROZEN · PENDING REVIEW</Text>
                </Glass>
              ) : null}
              {m.actions ? (
                <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6, marginTop: 8 }}>
                  {m.actions.map(a => <Pill key={a} text={a} tone="accent" />)}
                </View>
              ) : null}
            </View>
          ))}
          {busy && (
            <View style={{ marginBottom: 14, alignItems: 'flex-start' }}>
              <Glass style={{ padding: 12 }}>
                <ActivityIndicator color={t.accent} size="small" />
              </Glass>
            </View>
          )}
        </ScrollView>

        <Glass strong style={{ margin: 16, padding: 8, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <TextInput
            value={input}
            onChangeText={setInput}
            placeholder="Describe the incident…"
            placeholderTextColor={t.textFaint}
            style={{ flex: 1, color: t.text, fontSize: 14, paddingHorizontal: 10, paddingVertical: 10 }}
            onSubmitEditing={send}
            returnKeyType="send"
          />
          <TouchableOpacity onPress={send} disabled={busy}>
            <View style={{ paddingHorizontal: 16, paddingVertical: 11, borderRadius: 14, backgroundColor: busy ? t.textFaint : t.accent }}>
              <Text style={{ color: '#fff', fontWeight: '900', letterSpacing: 0.4 }}>Send</Text>
            </View>
          </TouchableOpacity>
        </Glass>

        <TouchableOpacity
          onPress={() => Vibration.vibrate(500)}
          style={{
            marginHorizontal: 16, marginBottom: 20, paddingVertical: 15,
            borderRadius: 16, backgroundColor: t.danger, alignItems: 'center',
            shadowColor: t.danger, shadowOpacity: 0.5, shadowRadius: 16,
          }}
        >
          <Text style={{ color: '#fff', fontWeight: '900', fontSize: 15, letterSpacing: 0.8 }}>
            🚨 EMERGENCY 911 / 112
          </Text>
        </TouchableOpacity>
      </SafeAreaView>
    </KeyboardAvoidingView>
