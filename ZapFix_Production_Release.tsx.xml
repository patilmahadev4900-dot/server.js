const ChamferButton: React.FC<{
  label: string; onPress: () => void; tone?: 'primary' | 'ghost' | 'danger' | 'success' | 'warn';
  style?: any; disabled?: boolean; sub?: string; icon?: string;
}> = ({ label, onPress, tone = 'primary', style, disabled, sub, icon }) => {
  const { t } = useTheme();
  const press = useRef(new Animated.Value(0)).current;
  const bg = tone === 'primary' ? t.accent
    : tone === 'danger' ? t.danger
    : tone === 'success' ? t.success
    : tone === 'warn' ? t.warn
    : 'transparent';
  const fg = tone === 'ghost' ? t.text : '#FFFFFF';
  const topLight = tone === 'ghost' ? t.chamfer : 'rgba(255,255,255,0.42)';
  const bottomShade = tone === 'ghost' ? t.chamferLow : 'rgba(0,0,0,0.28)';

  return (
    <Animated.View style={[{
      transform: [{
        translateY: press.interpolate({ inputRange: [0, 1], outputRange: [0, 2] }),
      }],
    }, style]}>
      <TouchableOpacity
        activeOpacity={0.9}
        disabled={disabled}
        onPressIn={() => Animated.timing(press, { toValue: 1, duration: 90, useNativeDriver: true }).start()}
        onPressOut={() => Animated.timing(press, { toValue: 0, duration: 140, useNativeDriver: true }).start()}
        onPress={onPress}
        style={{
          backgroundColor: disabled ? t.textFaint : bg,
          borderWidth: tone === 'ghost' ? 1.2 : 0,
          borderColor: t.glassBorder,
          borderRadius: 16,
          overflow: 'hidden',
          ...Platform.select({
            ios: {
              shadowColor: '#000',
              shadowOffset: { width: 0, height: 6 },
              shadowOpacity: tone === 'ghost' ? 0.10 : 0.28,
              shadowRadius: 10,
            },
            android: { elevation: disabled ? 0 : 5 },
          }),
        }}
      >
        <View style={{
          paddingVertical: 15, paddingHorizontal: 22,
          alignItems: 'center', justifyContent: 'center',
          flexDirection: 'row', gap: 8,
        }}>
          {icon ? <Text style={{ fontSize: 16, color: fg }}>{icon}</Text> : null}
          <View style={{ alignItems: 'center' }}>
            <Text style={{
              color: fg, fontSize: 15, fontWeight: '800',
