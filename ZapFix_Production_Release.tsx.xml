/* ═══════════════════════════════════════════════════════════════════════════
 * 10.  SCREEN 4 — 10-SECOND CAMERA
 *      Production override: accepts optional `recorder` prop. When present,
 *      the render tree attaches a real react-native-vision-camera <Camera />
 *      and drives recording through the recorder's start() / secondsLeft.
 * ═══════════════════════════════════════════════════════════════════════════ */

interface RecorderShape {
  cameraRef: React.MutableRefObject<any>;
  device: any;
  format: any;
  recording: boolean;
  secondsLeft: number;
  result: { path: string; hash: string } | null;
  permission: 'unknown' | 'granted' | 'denied';
  start: () => void;
}

const CameraScreen: React.FC<{
  onCapture: (hash: string) => void;
  onBack: () => void;
  onGallery: () => void;
  recorder?: RecorderShape;
}> = ({ onCapture, onBack, onGallery, recorder }) => {
  const [seconds, setSeconds] = useState(10);
  const [recording, setRecording] = useState(false);
  const [done, setDone] = useState(false);
  const [hash, setHash] = useState<string | null>(null);
  const pulse = useRef(new Animated.Value(1)).current;
  const ring = useRef(new Animated.Value(0)).current;

  /* Simulation fallback used only when no native recorder is provided */
  useEffect(() => {
    if (recorder) return;
    if (!recording || seconds <= 0) return;
    const id = setTimeout(() => setSeconds(s => s - 1), 1000);
    return () => clearTimeout(id);
  }, [recording, seconds, recorder]);

  useEffect(() => {
    if (recorder) return;
    if (seconds === 0 && recording) {
      setRecording(false); setDone(true);
      const seed = `${Date.now()}-${Math.random()}-zapfix-inspection-seed`;
      const h = sha256(seed);
      setHash(h);
      Vibration.vibrate(140);
    }
  }, [seconds, recording, recorder]);

  useEffect(() => {
    if (!recording) return;
    const loop = Animated.loop(Animated.sequence([
      Animated.timing(pulse, { toValue: 0.32, duration: 550, useNativeDriver: true }),
      Animated.timing(pulse, { toValue: 1,    duration: 550, useNativeDriver: true }),
    ]));
    loop.start();
    return () => loop.stop();
  }, [recording]);

  useEffect(() => {
    Animated.timing(ring, {
      toValue: (10 - seconds) / 10,
      duration: 900,
      easing: Easing.linear,
      useNativeDriver: false,
    }).start();
  }, [seconds]);

  /* Sync local state with the native recorder when present */
  useEffect(() => {
    if (!recorder) return;
    setRecording(recorder.recording);
    setSeconds(recorder.secondsLeft);
    if (recorder.result) { setDone(true); setHash(recorder.result.hash); }
  }, [recorder?.recording, recorder?.secondsLeft, recorder?.result?.hash]);

  const startSim = () => { setSeconds(10); setDone(false); setHash(null); setRecording(true); ring.setValue(0); };
  const start = () => recorder ? recorder.start() : startSim();
  const cameraAvailable = !!(recorder && VisionHooks && VisionHooks.Camera && recorder.device);

  return (
    <View style={{ flex: 1, backgroundColor: '#03060B' }}>
      <StatusBar barStyle="light-content" />
      <SafeAreaView style={{ flex: 1 }}>
        <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: 18 }}>
          <TouchableOpacity onPress={onBack}>
            <View style={{
              width: 40, height: 40, borderRadius: 20,
              backgroundColor: 'rgba(255,255,255,0.08)',
              borderWidth: 1, borderColor: 'rgba(140,180,220,0.24)',
              alignItems: 'center', justifyContent: 'center',
            }}><Text style={{ color: '#fff', fontSize: 16, fontWeight: '900' }}>✕</Text></View>
          </TouchableOpacity>
          <View style={{ alignItems: 'center' }}>
            <Text style={{ color: '#9FB3C8', fontSize: 10.5, fontWeight: '900', letterSpacing: 2.4 }}>
              EVIDENCE CAPTURE
            </Text>
            <Text style={{ color: '#5C7488', fontSize: 10.5, marginTop: 2, letterSpacing: 0.6 }}>
              10-second damage inspection
            </Text>
          </View>
          {recording ? (
            <Animated.View style={{ flexDirection: 'row', alignItems: 'center', gap: 8, opacity: pulse }}>
              <View style={{ width: 10, height: 10, borderRadius: 5, backgroundColor: '#FF3B3B' }} />
              <Text style={{ color: '#fff', fontWeight: '900', fontSize: 14, fontVariant: ['tabular-nums'], letterSpacing: 1 }}>
                REC 00:{String(seconds).padStart(2, '0')}
              </Text>
            </Animated.View>
          ) : <View style={{ width: 40 }} />}
        </View>

        <View style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
          {[
            { top: 44, left: 32, borderTopWidth: 3, borderLeftWidth: 3,  borderTopLeftRadius: 14 },
            { top: 44, right: 32, borderTopWidth: 3, borderRightWidth: 3, borderTopRightRadius: 14 },
            { bottom: 44, left: 32, borderBottomWidth: 3, borderLeftWidth: 3,  borderBottomLeftRadius: 14 },
            { bottom: 44, right: 32, borderBottomWidth: 3, borderRightWidth: 3, borderBottomRightRadius: 14 },
          ].map((s: any, i) => (
            <View key={i} style={[{ position: 'absolute', width: 48, height: 48, borderColor: 'rgba(120,180,255,0.85)' }, s]} />
          ))}

          {cameraAvailable ? (
            <VisionHooks.Camera
              ref={recorder!.cameraRef}
              style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0 }}
              device={recorder!.device}
              format={recorder!.format}
              isActive={true}
              video={true}
              audio={true}
            />
          ) : (
            <View pointerEvents="none" style={StyleSheet.absoluteFill}>
              {Array.from({ length: 10 }).map((_, i) => (
                <View key={i} style={{
                  position: 'absolute',
                  top: 80 + i * 60,
                  left: 40, right: 40, height: 1,
                  backgroundColor: 'rgba(120,180,255,0.08)',
                  transform: [{ rotate: `${-6 + i * 1.4}deg` }],
                }} />
              ))}
            </View>
          )}

          {(!recording && !done) && (
            <View style={{
              width: 250, height: 250, borderRadius: 34,
              backgroundColor: 'rgba(15,22,33,0.72)',
              borderWidth: 1, borderColor: 'rgba(120,180,255,0.28)',
              alignItems: 'center', justifyContent: 'center',
            }}>
