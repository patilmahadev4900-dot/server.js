/**
 * Honest billing math:
 *   Diagnostic Hold:  $69.00
 *   Labor (1.5 hr):   $127.50
 *   Parts:            $48.20
 *   Subtotal:         $244.70
 *   Tax @ 9.25%:      $22.63
 *   Total:            $267.33
 */
function computeBill(b: JobBill) {
  const labor = +(b.laborHours * b.laborRate).toFixed(2);
  const subtotal = +(b.diagnosticBase + labor + b.parts).toFixed(2);
  const tax = +(subtotal * b.taxRate).toFixed(2);
  const total = +(subtotal + tax).toFixed(2);
  return {
    diagnosticBase: b.diagnosticBase, labor, subtotal, tax, total,
    laborHours: b.laborHours, laborRate: b.laborRate, parts: b.parts,
    taxRate: b.taxRate,
  };
}

