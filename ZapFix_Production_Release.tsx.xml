/* ═══════════════════════════════════════════════════════════════════════════
 * 11.  SCREEN 5 — MANHATTAN VECTOR MAP + LIVE TELEMETRY
 *      In production, `progress` comes from useRouteProgress() fed by
 *      HMAC-verified frames from the Socket.io stream.
 * ═══════════════════════════════════════════════════════════════════════════ */

const CITY = {
  verticals:   [40, 86, 132, 178, 224, 270, 316].map(x => ({ x })),
  horizontals: [40, 86, 132, 178, 224, 270, 316, 362, 408, 454, 500, 546].map(y => ({ y })),
  river: { x: SCREEN_W - 56, w: 48 },
  buildings: Array.from({ length: 72 }).map((_, i) => {
    const col = i % 6, row = Math.floor(i / 6);
    const jitter = ((i * 37) % 7) - 3;
    return { left: 54 + col * 46 + jitter, top: 54 + row * 46 - jitter, size: 24 + ((i * 13) % 6) };
  }),
};

const ROUTE: { x: number; y: number }[] = [
  { x: 40,  y: 40  },
  { x: 178, y: 40  },
  { x: 178, y: 224 },
  { x: 316, y: 224 },
  { x: 316, y: 408 },
  { x: 224, y: 408 },
  { x: 224, y: 592 },
  { x: 86,  y: 592 },
];

const MapScreen: React.FC<{
  progress: number;
  etaMinutes: number;
  distanceMi: number;
  onArrive: () => void;
  onChat: () => void;
  onCall: () => void;
}> = ({ progress, etaMinutes, distanceMi, onArrive, onChat, onCall }) => {
  const { t } = useTheme();
  const [zoom, setZoom] = useState(1);
  const [centerTech, setCenterTech] = useState(true);
  const notified = useRef(false);

  const { pos, heading, nextTurn } = useMemo(() => {
    const total = ROUTE.length - 1;
    const scaled = progress * total;
    const idx = Math.min(Math.floor(scaled), total - 1);
    const local = scaled - idx;
    const a = ROUTE[idx], b = ROUTE[idx + 1];
    const x = a.x + (b.x - a.x) * local;
    const y = a.y + (b.y - a.y) * local;
    const dx = b.x - a.x, dy = b.y - a.y;
    const heading = Math.atan2(dy, dx) * (180 / Math.PI);
    const remaining = Math.hypot(dx, dy) * (1 - local);
    const nb = ROUTE[idx + 2] || b;
    const ndx = nb.x - b.x, ndy = nb.y - b.y;
    let dir: 'left' | 'right' | 'straight' = 'straight';
    if (ndx > 0 && dy < 0) dir = 'right';
    if (ndx > 0 && dy > 0) dir = 'left';
    if (ndx < 0 && dy > 0) dir = 'right';
    if (ndx < 0 && dy < 0) dir = 'left';
    return { pos: { x, y }, heading, nextTurn: { dir, dist: remaining } };
  }, [progress]);

  useEffect(() => {
    if (progress >= 0.995 && !notified.current) {
      notified.current = true;
      onArrive();
    }
  }, [progress, onArrive]);

  const cx = centerTech ? SCREEN_W / 2 - pos.x * zoom : 0;
  const cy = centerTech ? SCREEN_H / 2 - pos.y * zoom : 0;

  return (
    <View style={{ flex: 1, backgroundColor: t.bg }}>
      <View style={{ ...StyleSheet.absoluteFillObject, overflow: 'hidden', backgroundColor: t.bgDeep }}>
        <View style={{ transform: [{ translateX: cx }, { translateY: cy }, { scale: zoom }] }}>
          {CITY.verticals.map((v, i) => (
            <View key={`v${i}`} style={{ position: 'absolute', left: v.x - 1.5, top: 0, width: 3, height: SCREEN_H * 2, backgroundColor: t.contour }} />
          ))}
          {CITY.horizontals.map((h, i) => (
            <View key={`h${i}`} style={{ position: 'absolute', top: h.y - 1.5, left: 0, height: 3, width: SCREEN_W * 2, backgroundColor: t.contour }} />
          ))}
          <View style={{
            position: 'absolute', left: CITY.river.x, top: -600,
            width: CITY.river.w, height: 2600,
            backgroundColor: t.name === 'obsidian' ? 'rgba(60,140,220,0.26)' : 'rgba(90,170,230,0.32)',
            borderRadius: 26,
          }} />
          <View style={{ position: 'absolute', left: CITY.river.x + 14, top: -600, width: 8, height: 2600, backgroundColor: 'rgba(180,220,255,0.20)', borderRadius: 4 }} />
          {CITY.buildings.map((b, i) => (
            <View key={`b${i}`} style={{
              position: 'absolute', left: b.left, top: b.top,
              width: b.size, height: b.size,
              backgroundColor: t.name === 'obsidian' ? 'rgba(120,150,180,0.08)' : 'rgba(120,150,180,0.14)',
              borderRadius: 6,
              borderWidth: 0.6,
              borderColor: t.contour,
            }} />
          ))}
          {ROUTE.slice(0, -1).map((a, i) => {
            const b = ROUTE[i + 1];
            const vertical = a.x === b.x;
            return (
              <View key={`r${i}`} style={{
                position: 'absolute',
                left: vertical ? a.x - 5 : Math.min(a.x, b.x),
                top: vertical ? Math.min(a.y, b.y) : a.y - 5,
                width: vertical ? 10 : Math.abs(b.x - a.x),
                height: vertical ? Math.abs(b.y - a.y) : 10,
                backgroundColor: t.accent, opacity: 0.85, borderRadius: 5,
                shadowColor: t.accent, shadowOpacity: 0.85, shadowRadius: 10,
              }} />
            );
          })}
          <View style={{ position: 'absolute', left: pos.x - 22, top: pos.y - 22, width: 44, height: 44, borderRadius: 22, backgroundColor: t.accentGlow, opacity: 0.35 }} />
          <View style={{ position: 'absolute', left: pos.x - 14, top: pos.y - 14, width: 28, height: 28, borderRadius: 14, backgroundColor: t.accentGlow, opacity: 0.55 }} />
          <View style={{
            position: 'absolute', left: pos.x - 12, top: pos.y - 12,
            width: 24, height: 24, borderRadius: 12,
            backgroundColor: t.accent, borderWidth: 2.5, borderColor: '#fff',
            alignItems: 'center', justifyContent: 'center',
            transform: [{ rotate: `${heading}deg` }],
          }}>
            <Text style={{ fontSize: 11, color: '#fff', transform: [{ rotate: `${-heading}deg` }] }}>▲</Text>
          </View>
        </View>
      </View>

      <Glass strong style={{ margin: 16, marginTop: 52, padding: 14, flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <View style={{
          width: 46, height: 46, borderRadius: 14,
          backgroundColor: t.accent,
          alignItems: 'center', justifyContent: 'center',
        }}>
          <Text style={{ fontSize: 22, color: '#fff', fontWeight: '900' }}>
            {nextTurn.dir === 'right' ? '↱' : nextTurn.dir === 'left' ? '↰' : '↑'}
          </Text>
        </View>
        <View style={{ flex: 1 }}>
          <Text style={{ color: t.text, fontWeight: '900', fontSize: 14, letterSpacing: 0.2 }}>
            Turn {nextTurn.dir} onto Mountain Vista Blvd
          </Text>
          <Text style={{ color: t.textDim, fontSize: 12, marginTop: 3 }}>
            in {Math.round(nextTurn.dist)} m
          </Text>
        </View>
        <View style={{ alignItems: 'flex-end' }}>
          <Text style={{ color: t.accent, fontSize: 16, fontWeight: '900' }}>{etaMinutes} min</Text>
          <Text style={{ color: t.textFaint, fontSize: 11, marginTop: 2 }}>{distanceMi.toFixed(1)} mi</Text>
        </View>
      </Glass>

      <View style={{ position: 'absolute', right: 14, top: '38%', gap: 8 }}>
        <TouchableOpacity onPress={() => setZoom(z => Math.min(2.2, z + 0.2))}>
          <Glass style={{ width: 44, height: 44, alignItems: 'center', justifyContent: 'center' }} radius={14}>
            <Text style={{ color: t.text, fontSize: 20, fontWeight: '900' }}>+</Text>
          </Glass>
        </TouchableOpacity>
        <TouchableOpacity onPress={() => setZoom(z => Math.max(0.6, z - 0.2))}>
          <Glass style={{ width: 44, height: 44, alignItems: 'center', justifyContent: 'center' }} radius={14}>
            <Text style={{ color: t.text, fontSize: 20, fontWeight: '900' }}>−</Text>
          </Glass>
        </TouchableOpacity>
        <TouchableOpacity onPress={() => setCenterTech(c => !c)}>
          <Glass style={{ width: 44, height: 44, alignItems: 'center', justifyContent: 'center' }} radius={14}>
            <Text style={{ fontSize: 15 }}>🎯</Text>
          </Glass>
        </TouchableOpacity>
      </View>

      <Glass strong style={{ position: 'absolute', left: 16, right: 16, bottom: 24, padding: 14 }}>
        <View style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <View style={{
            width: 50, height: 50, borderRadius: 25,
            backgroundColor: t.accent, alignItems: 'center', justifyContent: 'center',
            shadowColor: t.accent, shadowOpacity: 0.6, shadowRadius: 12,
          }}><Text style={{ color: '#fff', fontWeight: '900', fontSize: 15 }}>MV</Text></View>
          <View style={{ flex: 1 }}>
            <Text style={{ color: t.text, fontWeight: '900', fontSize: 15 }}>{DEFAULT_TECH.name}</Text>
            <Text style={{ color: t.textDim, fontSize: 11.5, marginTop: 2 }}>
              {DEFAULT_TECH.license} · ★ {DEFAULT_TECH.rating}
            </Text>
            <Text style={{ color: t.textFaint, fontSize: 11, marginTop: 1 }}>{DEFAULT_TECH.vehicle} · {DEFAULT_TECH.plate}</Text>
          </View>
          <TouchableOpacity onPress={onCall}>
            <View style={{
              width: 48, height: 48, borderRadius: 16,
              backgroundColor: t.success, alignItems: 'center', justifyContent: 'center',
              shadowColor: t.success, shadowOpacity: 0.6, shadowRadius: 12,
            }}><Text style={{ fontSize: 20 }}>📞</Text></View>
          </TouchableOpacity>
          <TouchableOpacity onPress={onChat}>
            <View style={{
              width: 48, height: 48, borderRadius: 16,
              backgroundColor: t.accent, alignItems: 'center', justifyContent: 'center',
              shadowColor: t.accent, shadowOpacity: 0.6, shadowRadius: 12,
            }}><Text style={{ fontSize: 20 }}>💬</Text></View>
          </TouchableOpacity>
        </View>
      </Glass>
    </View>
  );
};

